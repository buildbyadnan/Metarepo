{
  "name": "@repo/web",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["@repo/api-endpoints:build"],
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/web"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["@repo/api-endpoints:build"],
      "options": {
        "command": "pnpm run dev",
        "cwd": "apps/web"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run deploy",
        "cwd": "apps/web"
      }
    },
    "cf-typegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run cf-typegen",
        "cwd": "apps/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint src/",
        "cwd": "apps/web"
      }
    }
  }
}
