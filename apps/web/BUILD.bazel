# apps/web: Next.js app.
#
# Bazel provides hermetic typecheck (same gate as `next build`'s type pass,
# minutes faster). Build/deploy stay with pnpm + next/opennextjs-cloudflare:
#   pnpm --filter @repo/web run build   (next build)
#   pnpm run deploy                     (opennextjs-cloudflare build && deploy)
# `next build` resolves @repo/api-endpoints -> dist, emitted by the pnpm tsc
# step in CI (never by Bazel; Bazel JS emit is out of scope of this phase).
# No test target: web has zero test files (root vitest finds none either).

load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = [
        "//:tsconfig_base",
        "//packages/api-endpoints:tsconfig",
    ],
)

ts_project(
    name = "typecheck",
    srcs = glob(
        [
            "src/**/*.ts",
            "src/**/*.tsx",
            # Gitignored (generated by `next dev/build`); present locally,
            # absent on clean CI checkouts -> allow_empty keeps both green.
            "next-env.d.ts",
        ],
        allow_empty = True,
    ),
    deps = [
        # Web's own linked deps (next, react, @repo/api-endpoints, ...).
        ":node_modules",
        # Root link tree: @types/react, @types/react-dom and friends are root
        # devDependencies, resolved by tsc via the workspace root node_modules
        # (same walk-up as in the pnpm tree).
        "//:node_modules",
    ],
    no_emit = True,
    tsconfig = ":tsconfig",
    validate = False,
)
