# Server API URL (optional)
# Defaults unconditionally to the production API
# (https://metarepo-api.adnanbuilds.online — see src/config/server.ts).
# Set it only to point the app elsewhere, e.g. local dev:
NEXT_PUBLIC_SERVER_URL=http://localhost:8787

# App name (optional)
# Used for branding in UI and metadata. Defaults to "MetaRepo".
NEXT_PUBLIC_APP_NAME=MetaRepo

# Site URL (optional)
# Used for metadata and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
