# Server API URL (optional)
# The URL of your Hono API server. If unset, production builds default to
# https://metarepo-api.adnanbuilds.online and dev builds to
# http://localhost:8787 (see src/config/server.ts). Only set this to point
# the app at a different API origin.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787

# App name (optional)
# Used for branding in UI and metadata. Defaults to "MetaRepo".
NEXT_PUBLIC_APP_NAME=MetaRepo

# Site URL (optional)
# Used for metadata and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
