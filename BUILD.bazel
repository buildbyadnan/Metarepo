load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")

# Links the root package.json dependencies (and the pnpm workspace's shared
# store) into bazel-out/node_modules, mirroring the pnpm layout exactly.
# In rules_js v3 this macro is generated from pnpm-lock.yaml into the @npm
# hub repository, so it only works in pnpm workspace packages — which is
# exactly what this root BUILD.bazel is.
npm_link_all_packages(name = "node_modules")

# The shared tsconfig that every package's tsconfig extends. Exposed as a
# ts_config so Bazel copies it into the bin tree and tracks it as an input of
# every tsc action that resolves the `extends` chain.
ts_config(
    name = "tsconfig_base",
    src = "tsconfig.base.json",
    visibility = ["//visibility:public"],
)
