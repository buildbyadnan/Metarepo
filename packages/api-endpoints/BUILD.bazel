load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

npm_link_all_packages(name = "node_modules")

# The target name `pkg` is required by rules_js v3: the pnpm workspace links
# are generated against //<package>:pkg of each first-party package. This
# package is consumed as built dist/ output (package.json main/types), so the
# package includes src, package.json and any nx-built dist output present.
npm_package(
    name = "pkg",
    srcs = glob(
        ["src/**"],
        allow_empty = True,
    ) + glob(
        ["dist/**"],
        allow_empty = True,
    ) + ["package.json"],
    visibility = ["//visibility:public"],
)

# The package's tsconfig.json is only a project-references shell over
# tsconfig.lib.json (the real build config). Both are exposed: consumers
# walking the project-reference chain (e.g. //apps/web) resolve the shell
# first, which then needs the lib config and the base it extends.
ts_config(
    name = "tsconfig_lib",
    src = "tsconfig.lib.json",
    deps = ["//:tsconfig_base"],
    visibility = ["//visibility:public"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = [
        "//:tsconfig_base",
        ":tsconfig_lib",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]),
    no_emit = True,
    tsconfig = ":tsconfig_lib",
    validate = False,
    deps = [
        # tsconfig.lib.json sets "types": ["node"].
        "//:node_modules/@types/node",
    ],
)
